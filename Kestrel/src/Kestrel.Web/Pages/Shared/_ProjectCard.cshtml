@model Project

<a class="card" asp-page="/Projects/Details" asp-route-id="@Model.Id">
    @if (!string.IsNullOrEmpty(Model.CoverImage))
    {
        <img src="~/uploads/@Model.CoverImage" alt="" loading="lazy" />
    }
    else
    {
        <span class="card-blank" aria-hidden="true">@Model.Category?.Name</span>
    }
    <span class="card-body">
        <span class="card-title">@Model.Title</span>
        <span class="card-meta">@Model.Location, @Model.Year</span>
    </span>
</a>
