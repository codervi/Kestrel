@page
@model Kestrel.Web.Pages.Admin.Categories.IndexModel
@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<form method="post" asp-page-handler="Add" class="inline-form" novalidate>
    <div class="field grow">
        <label asp-for="NewName"></label>
        <input asp-for="NewName" />
        <span asp-validation-for="NewName" class="field-error"></span>
    </div>
    <button type="submit" class="btn">Add category</button>
</form>

<div class="table-wrap">
    <table>
        <thead><tr><th>Name</th><th>Projects</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var c in Model.Items)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@c.ProjectCount</td>
                    <td class="actions">
                        <form method="post" asp-page-handler="Delete" asp-route-id="@c.Id" data-confirm="Delete the category &quot;@c.Name&quot;?">
                            <button type="submit" class="btn btn-small btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
